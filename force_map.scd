// force_hub.scd OSC mapping (14 signals: DC 0-6 then AC 0-6), written 2026-09-30 from the hardware team's spec:
// port 7500, /FSDC1../FSDC7 and /FSAC1../FSAC7 (7 = central). Ranges are guesses (DC 0..1, AC -1..1): press LEARN once they send.
[(addr: "/FSDC1", idx: 0, lo: 0, hi: 1), (addr: "/FSDC2", idx: 0, lo: 0, hi: 1), (addr: "/FSDC3", idx: 0, lo: 0, hi: 1), (addr: "/FSDC4", idx: 0, lo: 0, hi: 1), (addr: "/FSDC5", idx: 0, lo: 0, hi: 1), (addr: "/FSDC6", idx: 0, lo: 0, hi: 1), (addr: "/FSDC7", idx: 0, lo: 0, hi: 1), (addr: "/FSAC1", idx: 0, lo: -1, hi: 1), (addr: "/FSAC2", idx: 0, lo: -1, hi: 1), (addr: "/FSAC3", idx: 0, lo: -1, hi: 1), (addr: "/FSAC4", idx: 0, lo: -1, hi: 1), (addr: "/FSAC5", idx: 0, lo: -1, hi: 1), (addr: "/FSAC6", idx: 0, lo: -1, hi: 1), (addr: "/FSAC7", idx: 0, lo: -1, hi: 1)]
